# Copy this file to ".env" and fill in your own values.
# The .env file is git-ignored and must NEVER be committed.

# Required. Get one at https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_your_key_here

# Optional settings (defaults shown)
SURGISIGHT_CAMERA_INDEX=1
SURGISIGHT_MODEL=gemini-3.5-flash
SURGISIGHT_LANGUAGE=en
SURGISIGHT_RECORD_VIDEO=true
SURGISIGHT_SAVE_TRAINING_DATA=true
